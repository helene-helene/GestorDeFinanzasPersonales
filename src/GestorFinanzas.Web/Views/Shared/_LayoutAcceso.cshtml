<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3e6d8" />
    <title>@ViewData["Title"] - Finanzas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-layout">
        <section class="login-art login-simple">
            <div class="login-brand"><span class="brand-mark">$</span> Finanzas</div>
            <div class="login-intro">
                <p class="eyebrow">CONTROL FINANCIERO PERSONAL</p>
                <h1>Cuida tu dinero.<br />Protege tu futuro.</h1>
                <p>Organiza tus ingresos, controla tus gastos y revisa tus metas en un solo lugar.</p>
            </div>
            <div class="art-footer">Privacidad y organización para tus finanzas.</div>
        </section>
        <section class="login-form-side">
            <div class="login-card">
                @if (TempData["Exito"] is string exito)
                {
                    <div class="alert alert-success" role="status"><b>✓</b><span>@exito</span></div>
                }
                @RenderBody()
            </div>
        </section>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
