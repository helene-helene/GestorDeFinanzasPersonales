@model MovimientoFormViewModel
@{
    ViewData["Title"] = "Editar movimiento";
}

<h1 class="h3 mb-3">Editar movimiento</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" novalidate>
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/movimientos.js" asp-append-version="true"></script>
}
