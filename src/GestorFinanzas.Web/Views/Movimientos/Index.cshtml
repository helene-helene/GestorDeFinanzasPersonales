@model MovimientoIndexViewModel
@{
    ViewData["Title"] = "Movimientos";

    var f = Model.Filtro;
    var r = Model.Resultado;
    var desde = f.Desde?.ToString("yyyy-MM-dd");
    var hasta = f.Hasta?.ToString("yyyy-MM-dd");
    var hayFiltros = f.CuentaId.HasValue || !string.IsNullOrEmpty(f.Tipo) || f.CategoriaId.HasValue
                     || f.Desde.HasValue || f.Hasta.HasValue || !string.IsNullOrWhiteSpace(f.Texto);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Movimientos</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-circle me-1"></i>Registrar movimiento</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 border-success-subtle">
            <div class="card-body">
                <div class="text-secondary small">Ingresos</div>
                <div class="fs-4 fw-semibold text-success">$@Model.Resumen.TotalIngresos.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 border-danger-subtle">
            <div class="card-body">
                <div class="text-secondary small">Gastos</div>
                <div class="fs-4 fw-semibold text-danger">$@Model.Resumen.TotalGastos.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-secondary small">Balance</div>
                <div class="fs-4 fw-semibold @(Model.Resumen.Balance < 0 ? "text-danger" : "text-body")">$@Model.Resumen.Balance.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (hayFiltros)
{
    <p class="text-secondary small mb-2">Los totales corresponden a los movimientos que coinciden con los filtros aplicados.</p>
}

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-12 col-md-3">
            <label class="form-label small mb-1" for="filtro-texto">Buscar</label>
            <input id="filtro-texto" name="texto" value="@f.Texto" class="form-control" placeholder="Descripción o categoría" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="filtro-tipo">Tipo</label>
            <select id="filtro-tipo" name="tipo" class="form-select">
                <option value="">Todos</option>
                @foreach (var tipo in TipoMovimiento.Todos)
                {
                    <option value="@tipo" selected="@(f.Tipo == tipo)">@tipo</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="filtro-cuenta">Cuenta</label>
            <select id="filtro-cuenta" name="cuentaId" class="form-select">
                <option value="">Todas</option>
                @foreach (var cuenta in Model.Cuentas)
                {
                    <option value="@cuenta.Id" selected="@(f.CuentaId == cuenta.Id)">@cuenta.NombreCuenta</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1" for="filtro-categoria">Categoría</label>
            <select id="filtro-categoria" name="categoriaId" class="form-select">
                <option value="">Todas</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.Id" selected="@(f.CategoriaId == categoria.Id)">@categoria.Nombre (@categoria.Tipo)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="filtro-desde">Desde</label>
            <input id="filtro-desde" type="date" name="desde" value="@desde" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="filtro-hasta">Hasta</label>
            <input id="filtro-hasta" type="date" name="hasta" value="@hasta" class="form-control" />
        </div>
        <div class="col-12 col-md-6 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Filtrar</button>
            @if (hayFiltros)
            {
                <a class="btn btn-link" asp-action="Index">Quitar filtros</a>
            }
        </div>
    </div>
</form>

@if (r.Total == 0)
{
    <div class="card card-body text-center text-secondary py-5">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mb-0 mt-2">
            @(hayFiltros ? "No hay movimientos que coincidan con los filtros." : "Todavía no has registrado movimientos.")
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Cuenta</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in r.Items)
                    {
                        var esIngreso = t.Tipo == TipoMovimiento.Ingreso;
                        <tr>
                            <td class="text-nowrap">@t.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Descripcion) ? "—" : t.Descripcion)</td>
                            <td class="text-nowrap">
                                <i class="bi @t.Categoria.Icono me-1"></i>@t.Categoria.Nombre
                            </td>
                            <td class="text-nowrap">@t.Cuenta.NombreCuenta</td>
                            <td class="text-end text-nowrap fw-semibold @(esIngreso ? "text-success" : "text-danger")">
                                @(esIngreso ? "+" : "−")$@t.Monto.ToString("N2")
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id" title="Editar">
                                    <i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span>
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Id" title="Eliminar">
                                    <i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (r.TotalPaginas > 1)
    {
        var anterior = Math.Max(1, r.Pagina - 1);
        var siguiente = Math.Min(r.TotalPaginas, r.Pagina + 1);
        <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación del historial">
            <span class="text-secondary small">Página @r.Pagina de @r.TotalPaginas · @r.Total movimientos</span>
            <ul class="pagination mb-0">
                <li class="page-item @(r.Pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@anterior"
                       asp-route-tamanioPagina="@f.TamanioPagina" asp-route-texto="@f.Texto" asp-route-tipo="@f.Tipo"
                       asp-route-cuentaId="@f.CuentaId" asp-route-categoriaId="@f.CategoriaId"
                       asp-route-desde="@desde" asp-route-hasta="@hasta">Anterior</a>
                </li>
                <li class="page-item @(r.Pagina >= r.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@siguiente"
                       asp-route-tamanioPagina="@f.TamanioPagina" asp-route-texto="@f.Texto" asp-route-tipo="@f.Tipo"
                       asp-route-cuentaId="@f.CuentaId" asp-route-categoriaId="@f.CategoriaId"
                       asp-route-desde="@desde" asp-route-hasta="@hasta">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
}
