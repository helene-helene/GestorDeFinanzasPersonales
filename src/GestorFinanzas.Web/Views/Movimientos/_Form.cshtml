@model MovimientoFormViewModel
@{
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="mb-3">
    <label class="form-label d-block">Tipo de movimiento</label>
    <div class="btn-group" role="group" aria-label="Tipo de movimiento">
        @foreach (var tipo in TipoMovimiento.Todos)
        {
            <input class="btn-check" type="radio" name="Tipo" id="tipo-@tipo" value="@tipo"
                   checked="@(Model.Tipo == tipo)" autocomplete="off" />
            <label class="btn btn-outline-@(tipo == TipoMovimiento.Ingreso ? "success" : "danger")" for="tipo-@tipo">@tipo</label>
        }
    </div>
    <span asp-validation-for="Tipo" class="text-danger d-block small"></span>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="CuentaId" class="form-label"></label>
        <select asp-for="CuentaId" class="form-select">
            <option value="">Selecciona una cuenta</option>
            @foreach (var cuenta in Model.Cuentas)
            {
                <option value="@cuenta.Id" selected="@(Model.CuentaId == cuenta.Id)">
                    @cuenta.NombreCuenta (@cuenta.TipoCuenta) · $@cuenta.SaldoActual.ToString("N2")
                </option>
            }
        </select>
        <span asp-validation-for="CuentaId" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" class="form-select">
            <option value="">Selecciona una categoría</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria.Id" data-tipo="@categoria.Tipo" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option>
            }
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Monto" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
        </div>
        <span asp-validation-for="Monto" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" max="@hoy" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <input asp-for="Descripcion" class="form-control" maxlength="200" placeholder="Por ejemplo: almuerzo en la cafetería" />
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
</div>
