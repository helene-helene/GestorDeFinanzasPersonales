@model RegistroViewModel
@{
    Layout = "_LayoutAcceso";
    ViewData["Title"] = "Crear cuenta";
}

<form asp-action="Registro" method="post" class="login-card" novalidate>
    <h2>Crear cuenta</h2>

    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <label asp-for="Nombre"></label>
    <input asp-for="Nombre" autocomplete="name" maxlength="100" />
    <span asp-validation-for="Nombre"></span>

    <label asp-for="Correo"></label>
    <input asp-for="Correo" type="email" autocomplete="email" maxlength="150" />
    <span asp-validation-for="Correo"></span>

    <label asp-for="Contrasenia"></label>
    <input asp-for="Contrasenia" autocomplete="new-password" />
    <small class="ayuda">Mínimo 8 caracteres, con al menos una letra y un número.</small>
    <span asp-validation-for="Contrasenia"></span>

    <label asp-for="ConfirmarContrasenia"></label>
    <input asp-for="ConfirmarContrasenia" autocomplete="new-password" />
    <span asp-validation-for="ConfirmarContrasenia"></span>

    <button class="btn btn-primary btn-full" type="submit">Crear cuenta</button>
    <p class="signup">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
