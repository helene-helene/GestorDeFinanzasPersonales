@model IReadOnlyList<RecomendacionIA>
@{
    ViewData["Title"] = "Recomendaciones IA";
    (string Icono, string IconoClase, string Tag, string TagClase) Estilo(string tipo) => tipo switch
    {
        "Meta" => ("◎", "goal-icon", "META", "tag-goal"),
        var t when t.Contains("Gasto", StringComparison.OrdinalIgnoreCase) || t.Contains("Presupuesto", StringComparison.OrdinalIgnoreCase)
            => ("!", "spending-icon", t.ToUpperInvariant(), "tag-spending"),
        _ => ("↗︎", "savings-icon", tipo.ToUpperInvariant(), "tag-savings")
    };
}

<div class="page-heading">
    <div class="eyebrow">IDEAS PERSONALIZADAS</div>
    <h1>Recomendaciones de IA</h1>
    <p class="muted">Basadas en tus gastos, presupuestos y metas.</p>
</div>

<div class="ai-banner">
    <div class="ai-banner-icon">✦</div>
    <div><strong>Pequeños cambios hacen la diferencia</strong><p>Estas sugerencias se generan con tus datos reales y te ayudan a crear nuevos hábitos.</p></div>
</div>

@if (Model.Count == 0)
{
    <section class="panel empty-state" style="padding:32px;text-align:center">
        <div style="font-size:28px;margin-bottom:12px;color:#9a625e">✦</div>
        <h2>Aún no hay recomendaciones</h2>
        <p class="muted">Registra algunos gastos y define un presupuesto o una meta; el asistente tendrá con qué trabajar.</p>
        <a asp-controller="Movimientos" asp-action="Create" class="btn btn-primary">Registrar movimiento</a>
    </section>
}
else
{
    <div class="recommendation-list">
        @foreach (var r in Model)
        {
            var e = Estilo(r.TipoRecomendacion);
            <article class="recommendation-card @(r.Aplicada ? "aplicada" : "")">
                <div class="recommendation-icon @e.IconoClase">@e.Icono</div>
                <div class="recommendation-content">
                    <div class="recommendation-meta">
                        <span class="tag @e.TagClase">@e.Tag</span>
                        <span class="muted">@Formato.Fecha(r.FechaGeneracion)</span>
                    </div>
                    <p>@r.Descripcion</p>
                    @if (r.Aplicada)
                    {
                        <span class="pill pill-green">✓ Aplicada</span>
                    }
                    else
                    {
                        <form asp-action="Aplicar" asp-route-id="@r.Id" method="post">
                            <button class="btn btn-outline" type="submit">Marcar como aplicada</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
