@model IReadOnlyList<AvanceMeta>
@{
    ViewData["Title"] = "Metas y ahorros";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var estilos = new[] { "goal-laptop", "goal-trip", "goal-emergency" };
}

<div class="page-heading heading-with-action">
    <div>
        <div class="eyebrow">AHORRA A TU RITMO</div>
        <h1>Tus metas</h1>
        <p class="muted">Cada pequeño aporte te acerca a lo que sueñas.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">＋ Nueva meta</a>
</div>

@if (Model.Count == 0)
{
    <section class="panel empty-state" style="padding:32px;text-align:center">
        <div style="font-size:28px;margin-bottom:12px;color:#9a625e">◎</div>
        <h2>Todavía no tienes metas</h2>
        <p class="muted">Crea tu primera meta de ahorro y registra aportes para ver cómo avanzas.</p>
        <a class="btn btn-primary" asp-action="Create">Crear mi primera meta</a>
    </section>
}
else
{
    <div class="goals-grid">
        @foreach (var m in Model)
        {
            <article class="goal-card">
                <div class="goal-top">
                    <div class="goal-emoji @estilos[m.Id % estilos.Length]">◎</div>
                    <span class="pill @(m.Completa ? "pill-green" : "")">@(m.Completa ? "¡Completada!" : m.Porcentaje + "%")</span>
                </div>
                <h2>@m.Nombre</h2>
                <p class="muted">@(m.FechaLimite.HasValue ? "Fecha límite: " + Formato.Fecha(m.FechaLimite.Value) : "Sin fecha límite")</p>
                <div class="goal-amount"><strong>@Formato.Dinero(m.Ahorrado)</strong><span>de @Formato.Dinero(m.Objetivo)</span></div>
                <div class="progress-track mini-track"><i style="width:@(m.Porcentaje.ToString("0", inv))%;background:@(m.Completa ? "#78834f" : "#c9704f")"></i></div>
                <div class="line-foot"><span>@m.Porcentaje% logrado</span><span>@(m.Completa ? "Meta cumplida" : "Faltan " + Formato.Dinero(m.Faltante))</span></div>

                @if (!m.Completa)
                {
                    <form asp-action="Aportar" asp-route-id="@m.Id" method="post" class="aporte-form">
                        <div class="money-input"><span>$</span><input name="monto" type="number" step="0.01" min="0.01" inputmode="decimal" placeholder="Aporte" aria-label="Monto del aporte para @m.Nombre" required /></div>
                        <button class="btn btn-primary btn-sm" type="submit">Aportar</button>
                    </form>
                }
                <div class="goal-footer">
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('¿Eliminar esta meta?');">
                        <button type="submit" class="link-danger">Eliminar</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
