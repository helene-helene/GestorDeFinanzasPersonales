<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finanzas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" asp-page="/Index"><span class="brand-mark">$</span><span>Finanzas<small>Protección y control financiero</small></span></a>
            <div class="topbar-right"><span class="status-dot"></span> Mi espacio <span class="avatar" id="headerAvatar">?</span><span id="headerUserName" class="header-user-name">Mi cuenta</span></div>
        </header>
        <div class="layout-body">
            <aside class="sidebar">
                <div class="side-label">MENÚ PRINCIPAL</div>
                <a class="nav-link" asp-page="/Dashboard"><span></span>Inicio</a>
                <a class="nav-link" asp-page="/Movement"><span></span>Movimiento</a>
                <a class="nav-link" asp-page="/Budget"><span></span>Presupuesto</a>
                <a class="nav-link" asp-page="/Goals"><span></span>Metas</a>
                <a class="nav-link" asp-page="/Notifications"><span></span>Notificaciones </a>
                <a class="nav-link" asp-page="/Recommendations"><span></span>Recomendaciones IA</a>
                <a class="nav-link" asp-page="/Profile"><span></span>Perfil</a>
                <div class="sidebar-note"><div class="note-icon"></div><p>Organiza tu dinero sin complicarte.</p></div>
                <a class="nav-link logout-link" href="#" id="logoutLink"><span></span>Cerrar sesión</a>
            </aside>
            <main class="main-content">
                @RenderBody()
                <footer class="footer">Finanzas <span>Tu información, bajo tu control</span></footer>
            </main>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
