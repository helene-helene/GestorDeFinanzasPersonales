@page
@{
    ViewData["Title"] = "Perfil";
}
<div class="page-heading"><div class="eyebrow">TU ESPACIO PERSONAL</div><h1>Mi perfil</h1><p class="muted">Administra tu cuenta y tus preferencias.</p></div>
<section class="profile-hero panel"><div class="profile-avatar" id="profileAvatar">?</div><div class="profile-main"><h2 id="profileName">Cargando perfil…</h2><p id="profileEmail">Cargando correo…</p><span class="pill pill-green">Mi cuenta</span></div><button class="btn btn-outline" id="editProfile">Editar perfil</button></section>
<div class="profile-grid">
    <section class="panel profile-section"><div class="panel-heading"><h2>Datos de la cuenta</h2><span class="section-icon">♙</span></div><div class="profile-field"><span>Correo electrónico</span><strong id="accountEmail">—</strong></div><div class="profile-field"><span>Estado de la cuenta</span><strong>Activa</strong></div><div class="profile-field"><span>Miembro desde</span><strong id="memberSince">—</strong></div></section>
    <section class="panel profile-section"><div class="panel-heading"><h2>Preferencias</h2><span class="section-icon">⚙</span></div><div class="preference-row"><div><strong>Notificaciones</strong><small>Alertas de presupuesto y metas</small></div><label class="switch"><input type="checkbox" checked id="notificationsToggle"><span class="slider"></span></label></div><button class="settings-row" id="changePassword"><span><strong>Cambiar contraseña</strong><small>Actualiza la seguridad de tu cuenta</small></span><b>›</b></button><button class="settings-row" id="helpSupport"><span><strong>Ayuda y soporte</strong><small>Resuelve tus dudas</small></span><b>›</b></button><a class="settings-row signout-row" href="#" id="profileLogout"><span><strong>Cerrar sesión</strong><small>Salir de tu cuenta</small></span><b>↗</b></a></section>
</div>
<div id="profileMessage" class="form-message" aria-live="polite"></div>
