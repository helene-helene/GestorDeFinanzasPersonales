@page
@{
    ViewData["Title"] = "Inicio";
}
<div class="page-heading heading-with-action">
    <div><div class="eyebrow">RESUMEN PERSONAL</div><h1 id="dashboardGreeting">Hola</h1><p class="muted">Este es el resumen de tus finanzas de este mes.</p></div>
    <a class="btn btn-primary" asp-page="/Movement">＋ Nuevo movimiento</a>
</div>
<section class="hero-balance">
    <div class="balance-copy"><span class="light-label">SALDO DISPONIBLE ESTE MES</span><div class="balance-amount" id="dashBalance">$0.00</div><p>Has gastado <strong id="dashSpent">$0.00</strong> de <span id="dashBudget">$0.00</span> este mes</p><div class="progress-track"><span id="dashProgress" style="width:0%"></span></div><div class="balance-foot"><span id="dashPercent">0% utilizado</span><span>Presupuesto: <span id="dashBudgetFoot">$0.00</span></span></div></div>
    
</section>
<div class="section-heading"><div><h2>Tu resumen</h2><p class="muted">Así se distribuye tu dinero</p></div><a asp-page="/Budget" class="text-link">Ver presupuesto →</a></div>
<div class="stat-grid">
    <article class="stat-card"><div class="stat-icon icon-peach">↘</div><span class="muted">Gastos del mes</span><strong id="dashExpenseStat">$0.00</strong><small class="positive">Gastos registrados</small></article>
    <article class="stat-card"><div class="stat-icon icon-gold">＋</div><span class="muted">Ingresos del mes</span><strong id="dashIncomeStat">$0.00</strong><small>Ingresos registrados</small></article>
    <article class="stat-card"><div class="stat-icon icon-sage">◎</div><span class="muted">Metas activas</span><strong id="dashGoalsStat">0 metas</strong><small>Metas registradas</small></article>
</div>
<div class="dashboard-grid">
    <section class="panel"><div class="panel-heading"><div><h2>Gastos por categoría</h2><p class="muted">Tus gastos registrados</p></div><span class="pill">Este mes</span></div>
        <div id="dashboardCategories"><p class="muted">Todavía no tienes gastos registrados.</p></div>
    </section>
    <section class="ai-card"><div class="ai-title"><span class="ai-symbol">✦</span><div><span class="eyebrow">TU ASISTENTE</span><h2>Una idea para ti</h2></div></div><p id="dashboardTip">Registra tus ingresos y gastos para ver un resumen de tu dinero.</p><a asp-page="/Recommendations" class="btn btn-light">Ver recomendaciones <span>→</span></a><div class="sparkle">✦</div></section>
</div>
