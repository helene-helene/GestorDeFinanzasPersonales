@model PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
}

<h1 class="h3 mb-3">Mi perfil</h1>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <form asp-action="Index" method="post" class="card card-body" novalidate>
            <h2 class="h5 mb-3">Datos personales</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" maxlength="100" autocomplete="name" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" maxlength="150" autocomplete="email" />
                <div class="form-text">Es el correo con el que inicias sesión.</div>
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card card-body mb-3">
            <h2 class="h5 mb-3">Información de la cuenta</h2>
            <dl class="row mb-0">
                <dt class="col-6">@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
                <dd class="col-6">@(Model.FechaRegistro == DateTime.MinValue ? "—" : Model.FechaRegistro.ToString("dd/MM/yyyy"))</dd>
            </dl>
        </div>

        <div class="card card-body">
            <h2 class="h5 mb-3">Contraseña</h2>
            <a class="btn btn-outline-primary" asp-action="CambiarContrasenia">
                <i class="bi bi-key me-1"></i>Cambiar contraseña
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
